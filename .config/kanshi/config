# Profile applied when external monitor is connected
profile docked {
    output "eDP-1" disable
    output "HDMI-A-1" mode 2560x1440 position 0,0
}


# Profile applied when only the laptop screen is used (fallback)
profile undocked {
    output "eDP-1" enable
}

# Normal horizontal mode
profile landscape {
    output HDMI-A-1 enable transform normal position 0,0
}

# Vertical mode
profile portrait {
    output HDMI-A-1 enable transform 270 position 0,0
}
